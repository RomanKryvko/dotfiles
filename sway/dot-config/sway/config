# This config depends on external programs:
# conky - clock widget
# swayidle - idle manager
# sway-audio-idle-inhibit - prevent idling when playing audio
# hyprlock - screen locker
# brightnessctl - brightness control
# wl-gammarelay-rs - screen temperature control
# wpctl - volume control
# waybar - bar
# rofi - application launcher
# grim - screenshots
# slurp - screen region capture
# a terminal defined by TERMINAL env var

set $mod Mod1
set $bindCode bindsym --to-code

# Font for window titles
# Widely installed font:
# font pango:DejaVu Sans Mono 8
font pango: Ubuntu regular 14

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP XDG_SESSION_TYPE

exec --no-startup-id conky -qdc $HOME/.config/conky/way-clock.conf

exec wl-gammarelay-rs

exec "swayidle -w timeout 600 'brightnessctl g > /tmp/brightnessctl-sway && brightnessctl s 20%' resume 'brightnessctl s $(cat /tmp/brightnessctl-sway) || brightnessctl s 40%' timeout 630 'hyprlock &' timeout 720 'systemctl suspend' before-sleep hyprlock lock hyprlock"
exec 'sway-audio-idle-inhibit'

bar swaybar_command waybar

$bindCode $mod+b exec hyprlock

input type:touchpad {
    tap enabled
    natural_scroll enabled
}

input type:keyboard xkb_layout us,ru,ua
bindsym --release --locked $mod+Shift_L exec "swaymsg 'input type:keyboard xkb_switch_layout next'"

# Use wpctl to adjust volume in wireplumber.
bindsym --locked XF86AudioRaiseVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 5%+
bindsym --locked XF86AudioLowerVolume exec --no-startup-id wpctl set-volume @DEFAULT_SINK@ 5%-
bindsym --locked XF86AudioMute exec --no-startup-id wpctl set-mute @DEFAULT_SINK@ toggle
bindsym --locked XF86AudioMicMute exec --no-startup-id wpctl set-mute @DEFAULT_SOURCE@ toggle

# Control brightness
bindsym --locked XF86MonBrightnessUp exec brightnessctl s +5%
bindsym --locked XF86MonBrightnessDown exec brightnessctl s 5%-

bindsym $mod+XF86MonBrightnessUp exec busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n 200
bindsym $mod+XF86MonBrightnessDown exec busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n -200

bindgesture {
    swipe:3:left workspace prev
    swipe:3:right workspace next
    swipe:3:down move to scratchpad
    swipe:3:up scratchpad show
}

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

# start a terminal
bindsym $mod+Return exec --no-startup-id $TERMINAL

# kill focused window.
# Default:
# $bindCode $mod+Shift+q kill
bindsym $mod+F4 kill

# start rofi (a program launcher)
$bindCode $mod+d exec rofi -i -show drun -modi drun -show-icons -terminal $TERMINAL -config $HOME/.config/rofi/rofi.rasi -icons $HOME/.local/share/icons/ePapurus-Dark

# change focus
$bindCode $mod+h focus left
$bindCode $mod+j focus down
$bindCode $mod+k focus up
$bindCode $mod+l focus right

# move focused window
$bindCode $mod+Shift+h move left
$bindCode $mod+Shift+j move down
$bindCode $mod+Shift+k move up
$bindCode $mod+Shift+l move right

# split in horizontal orientation
# c because h conflicts with hjlk motions
$bindCode $mod+c split h

# split in vertical orientation
$bindCode $mod+v split v

# enter fullscreen mode for the focused container
$bindCode $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
$bindCode $mod+s layout stacking
$bindCode $mod+w layout tabbed
$bindCode $mod+e layout toggle split

# toggle tiling / floating
$bindCode $mod+space floating toggle
# toggle focus between floating and tiling
$bindCode $mod+x focus mode_toggle

# focus next window
$bindCode $mod+Tab focus next

# focus previous window
$bindCode $mod+ctrl+Tab focus prev

# Define names for default workspaces
set $ws1 " 1 "
set $ws2 " 2 "
set $ws3 " 3 "
set $ws4 " 4 "
set $ws5 " 5 "
set $ws6 " 6 "
set $ws7 " 7 "
set $ws8 " 8 "
set $ws9 " 9 "
set $ws10 " 10 "

# switch to workspace
$bindCode $mod+1 workspace $ws1
$bindCode $mod+2 workspace $ws2
$bindCode $mod+3 workspace $ws3
$bindCode $mod+4 workspace $ws4
$bindCode $mod+5 workspace $ws5
$bindCode $mod+6 workspace $ws6
$bindCode $mod+7 workspace $ws7
$bindCode $mod+8 workspace $ws8
$bindCode $mod+9 workspace $ws9
$bindCode $mod+0 workspace $ws10

# move focused container to workspace
$bindCode $mod+Shift+1 move container to workspace $ws1
$bindCode $mod+Shift+2 move container to workspace $ws2
$bindCode $mod+Shift+3 move container to workspace $ws3
$bindCode $mod+Shift+4 move container to workspace $ws4
$bindCode $mod+Shift+5 move container to workspace $ws5
$bindCode $mod+Shift+6 move container to workspace $ws6
$bindCode $mod+Shift+7 move container to workspace $ws7
$bindCode $mod+Shift+8 move container to workspace $ws8
$bindCode $mod+Shift+9 move container to workspace $ws9
$bindCode $mod+Shift+0 move container to workspace $ws10

# sway uses this instead of i3's restart function
$bindCode $mod+F5 reload

$bindCode ctrl+alt+Backspace exec "swaynag -t warning -m 'Exit sway?' -B 'Exit' 'swaymsg exit'"
# Starts shutdown/reboot/sleep/exit i3 menu
$bindCode $mod+Shift+e exec $HOME/.config/scripts/shutdown-menu.sh

# date format to use for grim filenames
set $DATEFORMAT $(date +"%Y-%m-%d-%H-%M-%S")
set $GRIMPATH "$HOME/Pictures/Screenshots/$DATEFORMAT.png"
# Take a screenshot with grim and save to ~/Pictures/Screenshots
bindsym Print exec grim $GRIMPATH
# Take a screenshot of a region and save to ~/Pictures/Screenshots
bindsym Shift+Print exec slurp | grim -g - $GRIMPATH
# Take a screenshot of a region and save to clipboard
bindsym ctrl+Print exec slurp | grim -g - - | wl-copy -t image/png

# resize window (you can also use the mouse for that)
mode "resize" {
        # These bindings trigger as soon as you enter the resize mode
        $bindCode h resize shrink width 10 px or 10 ppt
        $bindCode j resize grow height 10 px or 10 ppt
        $bindCode k resize shrink height 10 px or 10 ppt
        $bindCode l resize grow width 10 px or 10 ppt

        # back to normal: Enter or Escape or $mod+r
        $bindCode Return mode "default"
        $bindCode Escape mode "default"
        $bindCode $mod+r mode "default"
}

$bindCode $mod+r mode "resize"

# Display background
output * background $($HOME/.config/scripts/pick-rnd-wallpaper.sh) fill

# Gaps
smart_gaps on
smart_borders on
hide_edge_borders smart
gaps inner 10
gaps outer 10

focus_on_window_activation focus

workspace_auto_back_and_forth yes

# colours
set $frost3 #81a1c1
set $frost4 #5e81ac
set $storm1 #d8dee9
set $storm2 #e5e9f0
set $storm3 #eceff4
set $night1 #2e3440
set $night2 #3b4252
set $night3 #434c5e
set $night4 #4c566a
set $urgent_red #bf616a

## class                 border  backgr. text    indicator child_border
client.focused          $frost4 $frost4 #ffffff $storm1  $frost4
client.focused_inactive $night1 $night3 #ffffff $frost3  $night4
client.unfocused        $night2 $night3 #888888 $storm1  $night3
client.urgent           #2f343a $urgent_red #ffffff $urgent_red $urgent_red

# Window title settings
# Default: Hide window title
for_window [class=".*"] border pixel 4

$bindCode $mod+t border toggle

