{
    "on-sigusr1": "reload",
    "reload_style_on_change": true,
    "position": "bottom",
    "height": 30,
    "spacing": 5,
    "modules-left": [
        "sway/workspaces",
        "sway/scratchpad",
        "sway/mode"
    ],
    "modules-center": [
    ],
    "modules-right": [
        "wireplumber#sink",
        "network",
        "backlight",
        "custom/screen-temperature",
        "battery",
        "cpu",
        "memory",
        "sway/language",
        "clock",
        "tray"
    ],
    "sway/workspaces": {
        "all-outputs": true,
        "sort-by-id": true,
        "disable-scroll": true,
        "disable-auto-back-and-forth": true
    },
    "sway/language": {
        "hide-single-layout": true,
        "tooltip": true,
        "tooltip-format": "{long}"
    },
    "sway/mode": {
        "format": "<span style=\"italic\">{}</span>"
    },
    "sway/scratchpad": {
        "format": "{icon} {count}",
        "show-empty": false,
        "format-icons": ["", ""],
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },
    "tray": {
        "spacing": 10
    },
    "clock": {
        "format": "{:%d %b %Y | %H:%M}",
        "tooltip": true,
        "tooltip-format": "{:%Z: %d/%m/%Y | %H:%M:%S}",
        "interval": 1
    },
    "cpu": {
        "format": "{usage}%  ",
        "tooltip": false,
        "interval": 2
    },
    "memory": {
        "format": "{}%  "
    },
    "backlight": {
        "format": "{percent}% 󰌵",
        "scroll-step": 5,
        "min-brightness": 5.0,
        "tooltip": false
    },
    "battery": {
        "states": {
            "warning": 20,
            "critical": 10
        },
        "format": "{capacity}%  "
    },
    "network": {
        "format-wifi": "󰖩 ",
        "format-ethernet": "󰛳 ",
        "format-disconnected": "NET: DISC",
        "tooltip-format": "{essid} | {ipaddr}/{cidr}"
    },
    "wireplumber#sink": {
        "format": "{volume}% 󰕾",
        "format-muted": "󰝟",
        "on-click": "pwvucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5,
        "max-volume": 150
    },
    "custom/screen-temperature": {
        "format": "{icon} {text}",
        "format-icons": ["", ""],
        "return-type": "json",
        "exec": "~/.config/waybar/scripts/temp-watch.sh",
        "on-click": "~/.config/waybar/scripts/temp-toggle.sh",
        "on-scroll-up": "busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n +200",
        "on-scroll-down": "busctl --user -- call rs.wl-gammarelay / rs.wl.gammarelay UpdateTemperature n -200"
    },
    "user": {
        "format": "  {user} | up {work_H}:{work_M}"
    }
}
